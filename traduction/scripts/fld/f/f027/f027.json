      "notes": ""
    },
    {
      "id": 12,
      "offset": "AREA_07_NPC_02",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "> Obtained Oxygen Tank.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 13,
      "offset": "AREA_07_NPC_03",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Stay mindful of the current, as\nwell as Solar Noise.\nWhen Noise is at its maximum,\nthe waterway will flood, and you'll\nbe swept back here.\nBest of luck reaching the exit.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 14,
      "offset": "AREA_07_NPC_04",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Should I explain that one\nmore time?",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 15,
      "offset": "AREA_07_NPC_05",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Stay mindful of the current, as\nwell as Solar Noise.\nWhen Noise is at its maximum,\nyou'll be swept back here. Reach\nthe exit as quickly as possible.",
