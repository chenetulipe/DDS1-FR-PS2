    {
      "id": 33,
      "offset": "BATTLE_031_02",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "You're runnin' away!? That makes\nme laugh--Embryon's leader is\njust a stupid coward!",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 34,
      "offset": "BATTLE_031_03",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "It makes me laugh dat you were\nstupid enough to fall for such\nan obvious trap!",
