{
  "file_name": "f026.bf",
  "total_messages": 96,
  "messages": [
    {
      "id": 0,
      "offset": "OPERATION_01",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "You understand the plan, correct?\nFirst, we will plant an explosive\nat the bottom of the ship.\nLet us proceed.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 1,
      "offset": "STOP_01",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Leave this sector to Argilla.\nWe must proceed to the bottom\nof the ship.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 2,
      "offset": "NOTOPEN_01",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "We shall enter that sector later.\nFirst, let us proceed to the bottom of\nthe ship.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 3,
      "offset": "NOTOPEN_02",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Serph, the bottom of the ship\nlies in this direction.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 4,
      "offset": "WARNING",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "> A message is written:\nDANGER!\nEngine Room ahead.\nEmployees only beyond this point.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 5,
      "offset": "CHECK_EXIT_01",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Do you understand the operation?\nLet us proceed to the bottom of\nthe ship.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 6,
      "offset": "CHECK_EXIT_02",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Do you understand the operation?\nAfter we plant an explosive on\neach floor, we will join Argilla\nin the hall.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 7,
      "offset": "CHECK_EXIT_03",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "What are you doing?\nLet us return to the hall.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 8,
      "offset": "SET_BOMB_01",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "This is satisfactory.\nLet us plant the explosive here.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 9,
      "offset": "SET_BOMB_02",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "As we ascend, we must plant explosives\non the floors above.\nOne explosive is needed per floor,\nfor a total of seven.\nExpedience is required for this mission.\nLet us hurry.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 10,
      "offset": "FIRSTBATTLE_01",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "There they are! It's them!",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 11,
      "offset": "FIRSTBATTLE_02",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Capture the leader and the girl,\nbut kill everyone else!",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 12,
      "offset": "NOTUSE_01",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "As discussed previously...\n...we cannot return via the same\nelevator we arrived in. Use the door\nto the right, instead.\nYou, Leader, are the bait.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 13,
      "offset": "NOTUSE_03",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Move quickly from place to place,\nand draw our opponents inside.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 14,
      "offset": "NOTUSE_02",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Do not run too quickly, or your\nrole as bait will be jeopardized.\nLet us take the right aisle.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 15,
      "offset": "BATTLE_012_01",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "There they are...",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 16,
      "offset": "BATTLE_012_02",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "The Silver Fox is on the move:\nport side, toward the bow.\nCall for backup!",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 17,
      "offset": "BATTLE_012_03",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Dey took de bait!\nIt's just like we planned...",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 18,
      "offset": "BATTLE_012_04",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Do not speak hastily.\nWe cannot allow them to believe\nour leader is worth so few of\ntheir soldiers.\nDestroy them so we may continue.",
      "texte_fr": "",
      "notes": ""
    },
    {
      "id": 19,
      "offset": "SETBOMB_3F",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Alright, let us set one here.",
      "texte_fr": "",
