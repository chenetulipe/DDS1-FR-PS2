    {
      "id": 29,
      "offset": "BOSS_03",
      "block_type": "msg",
      "nom_orig": "",
      "nom_fr": "",
      "texte_orig": "Once we kill you, we'll be able\nto escape this ridiculous\nnightmare at last!\nColonel Beck isn't the only one\nwho wants to get the hell out\nof here!",
